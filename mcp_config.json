{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Customer Support Intelligence MCP Configuration",
  "version": "1.0.0",
  "mcpServers": {
    "ecommerce-support": {
      "command": ".venv/bin/python",
      "args": ["-m", "src.mcp.support_mcp_server"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": ".",
        "GUARDRAILS_DISABLE_TELEMETRY": "true",
        "CREWAI_DISABLE_TELEMETRY": "true"
      },
      "description": "Exposes e-commerce OMS order lookup, ChromaDB policy RAG, and financial risk verification."
    }
  }
}
